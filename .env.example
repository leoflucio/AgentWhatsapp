# Copie para .env (local, nunca versionado). Em produção, configure como segredos da hospedagem.

# --- Públicas (cliente) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=      # segredo
# Servidor Evolution API (o mesmo do FisioAI pode ser usado; as instâncias daqui começam com agw_)
EVOLUTION_HOST_URL=
# EVOLUTION_HOST_KEY=             # segredo (chave mestra do servidor)
# Endereço público do app, usado no webhook (ex.: https://agente.seudominio.com.br)
PUBLIC_APP_URL=
# IA pelo gateway da Lovable
# LOVABLE_API_KEY=                # segredo
# Transcrição de áudio (opcional)
# GROQ_API_KEY=                   # segredo
