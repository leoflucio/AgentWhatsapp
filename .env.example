# Copie para .env e preencha. Nunca versione o .env.

# --- Supabase (supabase.com › Project Settings › API) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor Evolution API (pode ser o mesmo do FisioAI; as instâncias daqui começam com agw_) ---
EVOLUTION_HOST_URL=
EVOLUTION_HOST_KEY=

# Endereço público do app com HTTPS, usado no webhook (ex.: https://agente.seudominio.com.br)
PUBLIC_APP_URL=
# Domínio do app (sem https://), já apontado para a VPS. Liga o HTTPS pelo Traefik.
APP_DOMAIN=

# --- IA (qualquer provedor compatível com a API da OpenAI; padrão: Gemini do Google AI Studio) ---
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash
# AI_MODEL_LITE=gemini-3.1-flash-lite

# Transcrição de áudio (opcional, groq.com)
# GROQ_API_KEY=

# --- Cobrança das assinaturas (asaas.com › Integrações) ---
# Chave da API SEM o $ do começo (aact_prod_... = produção; outras = sandbox)
ASAAS_API_KEY=
# Token que você inventa e coloca também no webhook do Asaas
# (URL: https://SEU_ENDERECO/api/public/asaas/webhook)
ASAAS_WEBHOOK_TOKEN=

# E-mails do dono do app (painel do dono, sem cobrança e sem limite), separados por vírgula
ADMIN_EMAILS=
# App da Play Store (TWA): pacote e impressão digital SHA-256 da chave do Play Console
ANDROID_PACKAGE=
ANDROID_SHA256=
